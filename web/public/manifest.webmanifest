:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #edf2ff;
  background: linear-gradient(180deg, #070d18 0%, #0b1020 100%);
  color-scheme: dark;
  line-height: 1.5;
  font-weight: 400;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top, rgba(108, 129, 255, 0.2), transparent 28%),
    linear-gradient(180deg, #050b14 0%, #0b1020 100%);
}

button {
  font: inherit;
}

.app-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 32px 20px 80px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-bottom: 24px;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3.2rem);
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.75rem;
  color: #8da6ff;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgba(142, 167, 255, 0.4);
  background: rgba(11, 16, 32, 0.75);
  color: #dfe8ff;
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 0.78rem;
}

.primary {
  border: 0;
  background: linear-gradient(135deg, #7c9cff 0%, #63d0ff 100%);
  color: #06111d;
  font-weight: 700;
  padding: 0.8rem 1.2rem;
  border-radius: 12px;
  cursor: pointer;
}

.nav {
  margin-top: 16px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.nav-item {
  padding: 0.7rem 1rem;
  color: #dfe8ff;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(203, 213, 255, 0.12);
  border-radius: 12px;
  cursor: pointer;
  text-transform: capitalize;
}

.nav-item.active {
  background: rgba(124, 156, 255, 0.18);
  border-color: rgba(124, 156, 255, 0.4);
}

.content {
  display: block;
}

.hero-card,
.card,
.panel {
  background: rgba(11, 16, 32, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 14px 32px rgba(2, 6, 23, 0.28);
  border-radius: 18px;
}

.hero-card {
  padding: 24px;
  display: grid;
  gap: 18px;
  margin-bottom: 20px;
}

.hero-card h2 {
  margin: 8px 0 0;
  font-size: clamp(1.5rem, 3vw, 2.7rem);
}

.grid.cards {
  display: grid;
  gap: 18px;
}

.three-up {
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
}

.card {
  padding: 18px;
}

.card h3 {
  margin-top: 0;
}

.card p {
  color: #cfe0ff;
}

.card code {
  display: block;
  overflow-wrap: anywhere;
  background: rgba(148, 163, 184, 0.08);
  border-radius: 8px;
  padding: 8px;
  font-size: 0.74rem;
  margin: 10px 0;
}

.card small {
  color: #a6c4ff;
  display: block;
}

.panel {
  padding: 24px;
}

.panel h2 {
  margin-top: 0;
}

.panel ul {
  margin: 20px 0 0;
  padding-left: 1.25rem;
  color: #d6e4ff;
}

.status-text {
  margin-top: 14px;
  color: #a9d2ff;
}

@media (max-width: 720px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .topbar-actions {
    width: 100%;
    justify-content: space-between;
  }
}
